# AgentForge configuration — copy to .env and fill in. .env is gitignored; never commit secrets.

# --- Amazon Bedrock (all models run here, under one AWS BAA) -------------------------------
# A Bedrock API key / bearer token. boto3 and the Anthropic SDK both read this from the env.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AGENTFORGE_AWS_REGION=us-east-1

# Judge = Bedrock Claude (reliability-critical, independent family from the attacker).
AGENTFORGE_JUDGE_MODEL=us.anthropic.claude-opus-4-8
# Orchestrator + Documentation strategic calls (low volume).
AGENTFORGE_ORCHESTRATOR_MODEL=us.anthropic.claude-sonnet-5
# Red Team novel-seed model = a non-Claude model measured to comply with authorized red-teaming.
AGENTFORGE_REDTEAM_SEED_MODEL=us.meta.llama4-maverick-17b-instruct-v1:0

# --- Target (the system under test) --------------------------------------------------------
# The deployed application AgentForge attacks. Treated as an immutable allow-list.
#
# NOTE (2026-07-22): the host below is DECOMMISSIONED and no longer resolves. It is left as the
# default because it documents what the published results were measured against, and because the
# allow-list is a security control — the platform can attack this origin and nothing else, so a
# dead default fails closed. Point it at your own deployment to run live commands. None of the
# hermetic paths (`agentforge demo`, `pytest`) read this at all.
AGENTFORGE_TARGET_URL=https://45-55-53-165.sslip.io/copilot
# Target API key for authenticated attacks (the system-under-test's own key). Optional: without
# it, only the unauthenticated boundary is exercised. Keep this out of the repo.
AGENTFORGE_TARGET_API_KEY=

# --- Observability (optional; tracing is a no-op if these are unset) ------------------------
# Langfuse traces per-agent campaign runs. PHI-shaped values are masked before sending. For
# SYNTHETIC data, Langfuse Cloud is fine; for real PHI, self-host Langfuse inside the same BAA.
AGENTFORGE_LANGFUSE_PUBLIC_KEY=
AGENTFORGE_LANGFUSE_SECRET_KEY=
AGENTFORGE_LANGFUSE_HOST=https://us.cloud.langfuse.com

# --- SSO: Login with OpenEMR (optional; login is disabled until a client is registered) -----
# Register the dashboard once:  agentforge sso-register --redirect-uri <dashboard>/callback
# which writes .sso-credentials.env — move these three into here / your host env (never commit).
AGENTFORGE_SSO_CLIENT_ID=
AGENTFORGE_SSO_CLIENT_SECRET=
AGENTFORGE_SSO_REDIRECT_URI=
AGENTFORGE_SSO_ISSUER=https://45-55-53-165.sslip.io/oauth2/default
# RBAC (deny-by-default): authorized operator identities and/or roles.
AGENTFORGE_SSO_OPERATOR_ALLOWLIST=
AGENTFORGE_SSO_OPERATOR_ROLES=admin,security-operator,administrator
# Set to 1 to require login for the read view too (production). Off = public read + gated actions.
AGENTFORGE_SSO_REQUIRE=0
# Post-disclosure mode. Off by default: exploit detail (reports, finding titles, attack chains) is
# operator-only, because publishing a working attack sequence against a *live* system is the
# anti-pattern this platform exists to flag. Set to 1 only once the target is decommissioned and
# every finding is fixed — then the reports are evidence, not a weapon, and withholding them just
# makes the claims unverifiable. Opens READS ONLY: POST /api/run/<category> stays gated either way.
# Re-gating a redeployment is removing this one variable. The public deployment sets it to 1.
AGENTFORGE_PUBLIC_REPORTS=0
# Only enable an off-by-default attacker model (e.g. DeepSeek) behind this explicit flag.
AGENTFORGE_ALLOW_FLAGGED_MODELS=0

# --- Deploy (optional; only needed to deploy the dashboard yourself) ------------------------
# RAILWAY_TOKEN=
