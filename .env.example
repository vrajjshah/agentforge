# AgentForge configuration — copy to .env and fill in. .env is gitignored; never commit secrets.

# --- Amazon Bedrock (all models run here, under one AWS BAA) -------------------------------
# A Bedrock API key / bearer token. boto3 and the Anthropic SDK both read this from the env.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AGENTFORGE_AWS_REGION=us-east-1

# Judge = Bedrock Claude (reliability-critical, independent family from the attacker).
AGENTFORGE_JUDGE_MODEL=us.anthropic.claude-opus-4-8
# Orchestrator + Documentation strategic calls (low volume).
AGENTFORGE_ORCHESTRATOR_MODEL=us.anthropic.claude-sonnet-5
# Red Team novel-seed model = a non-Claude model measured to comply with authorized red-teaming.
AGENTFORGE_REDTEAM_SEED_MODEL=us.meta.llama4-maverick-17b-instruct-v1:0

# --- Target (the system under test) --------------------------------------------------------
# The deployed application AgentForge attacks. Treated as an immutable allow-list.
AGENTFORGE_TARGET_URL=https://45-55-53-165.sslip.io/copilot
# Target API key for authenticated attacks (the system-under-test's own key). Optional: without
# it, only the unauthenticated boundary is exercised. Keep this out of the repo.
AGENTFORGE_TARGET_API_KEY=

# --- Deploy (optional; only needed to deploy the dashboard yourself) ------------------------
# RAILWAY_TOKEN=
