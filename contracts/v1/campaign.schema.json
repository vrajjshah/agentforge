{
  "$defs": {
    "AttackCategory": {
      "enum": [
        "prompt_injection",
        "data_exfiltration",
        "state_corruption",
        "tool_misuse",
        "denial_of_service",
        "identity_role",
        "concurrency_idempotency"
      ],
      "title": "AttackCategory",
      "type": "string"
    },
    "AuthPrincipal": {
      "enum": [
        "none",
        "session",
        "api_key"
      ],
      "title": "AuthPrincipal",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Orchestrator \u2192 Red Team. Carries the F2 per-campaign capability grant.",
  "properties": {
    "allowed_methods": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Methods",
      "type": "array"
    },
    "allowed_path_prefixes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Path Prefixes",
      "type": "array"
    },
    "auth_principals": {
      "items": {
        "$ref": "#/$defs/AuthPrincipal"
      },
      "title": "Auth Principals",
      "type": "array"
    },
    "blocked_path_substrings": {
      "items": {
        "type": "string"
      },
      "title": "Blocked Path Substrings",
      "type": "array"
    },
    "budget_usd": {
      "default": 20.0,
      "title": "Budget Usd",
      "type": "number"
    },
    "category": {
      "$ref": "#/$defs/AttackCategory"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "halt_after_no_signal": {
      "default": 20,
      "title": "Halt After No Signal",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "max_attempts": {
      "default": 50,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_turns_per_attempt": {
      "default": 4,
      "title": "Max Turns Per Attempt",
      "type": "integer"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_ids": {
      "items": {
        "type": "string"
      },
      "title": "Seed Ids",
      "type": "array"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "target_version": {
      "default": "",
      "title": "Target Version",
      "type": "string"
    }
  },
  "required": [
    "name",
    "category",
    "target_id"
  ],
  "title": "Campaign",
  "type": "object"
}
